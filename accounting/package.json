{
  "name": "fantastic-accounting",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "node ./scripts/db-migrate.js",
    "db:seed": "pnpm build && node dist/scripts/db-seed.js",
    "db:setup": "pnpm db:migrate && pnpm db:seed",
    "import:declarations": "pnpm build && node dist/scripts/import-declarations.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.4",
    "drizzle-orm": "^0.41.0",
    "pg": "^8.14.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "^8.15.2",
    "drizzle-kit": "^0.30.6",
    "typescript": "^5.8.2",
    "vitest": "^3.1.1"
  }
}
